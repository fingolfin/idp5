#############################################################################
##
##  idp5.tst                                                Idp5 package
##
gap> START_TEST("idp5.tst");

#
# Helper functions.  CheckGroups(p, e, copy, iso) runs over all groups H of
# order p^e, constructs G := copy(H), and checks IdSmallGroup(G); if iso is
# true, then it also checks that IsomorphismSmallGroup(G) is an isomorphism
# from G onto the library group.  The list of failures is returned.
#
gap> IsIsoOntoLibraryGroup := function(G, iso, id)
>   local gens, hom;
>   if iso = fail or Source(iso) <> G or IdSmallGroup(Range(iso)) <> id then
>     return false;
>   fi;
>   gens := GeneratorsOfGroup(G);
>   hom := GroupHomomorphismByImages(G, Range(iso), gens,
>                                    List(gens, g -> Image(iso, g)));
>   return hom <> fail and IsBijective(hom);
> end;;
gap> CheckGroups := function(p, e, copy, iso)
>   local bad, i, G;
>   bad := [];
>   for i in [1..NumberSmallGroups(p^e)] do
>     G := copy(SmallGroup(p^e, i));
>     if IdSmallGroup(G) <> [p^e, i] then
>       Add(bad, ["id", p^e, i]);
>     elif iso and
>          not IsIsoOntoLibraryGroup(G, IsomorphismSmallGroup(G), [p^e, i]) then
>       Add(bad, ["iso", p^e, i]);
>     fi;
>   od;
>   return bad;
> end;;
gap> PcgsCopy := p5id_random_pcgscopy;;
gap> GensCopy := H -> Group(GeneratorsOfGroup(H));;

# a regular permutation group, generated by random elements
gap> RegCopy := function(H)
>   local P, G;
>   P := Image(RegularActionHomomorphism(H));
>   repeat
>     G := Group(List([1..6], i -> Random(P)));
>   until Size(G) = Size(P);
>   return G;
> end;;

#
# All groups of order p^e, e <= 5, for small primes, given by random pcgs;
# 7, 11, 13 and 17 cover the four values of [Gcd(p-1,3), Gcd(p-1,4)]
#
gap> ForAll([7, 11, 13, 17],
>           p -> ForAll([1..5], e -> CheckGroups(p, e, PcgsCopy, true) = []));
true

# for p in [2, 3, 5] the IDs are computed by the SmallGroups library
gap> ForAll([2, 3, 5],
>           p -> ForAll([1..5], e -> CheckGroups(p, e, PcgsCopy, true) = []));
true

# copies without stored attributes, with respect to the library pcgs
gap> CheckGroups(19, 5, GensCopy, false);
[  ]
gap> CheckGroups(19, 4, GensCopy, true);
[  ]

#
# Other representations
#
gap> CheckGroups(7, 3, RegCopy, true);
[  ]
gap> ForAll([2, 12, 30, 47, 60, 65, 70, 83], function(i)
>      local G;
>      G := RegCopy(SmallGroup(7^5, i));
>      return IdSmallGroup(G) = [7^5, i] and
>             IsIsoOntoLibraryGroup(G, IsomorphismSmallGroup(G), [7^5, i]);
>    end);
true

# matrix groups
gap> S := SylowSubgroup(GL(3, 7), 7);;
gap> IdSmallGroup(S);
[ 343, 3 ]
gap> IsIsoOntoLibraryGroup(S, IsomorphismSmallGroup(S), [343, 3]);
true

# finitely presented groups
gap> F := Image(IsomorphismFpGroup(SmallGroup(7^4, 7)));;
gap> IdSmallGroup(F);
[ 2401, 7 ]
gap> F := Image(IsomorphismFpGroup(SmallGroup(7^5, 40)));;
gap> IdSmallGroup(F);
[ 16807, 40 ]
gap> IsIsoOntoLibraryGroup(F, IsomorphismSmallGroup(F), [7^5, 40]);
true

#
# A larger prime: all IDs, and isomorphisms for some groups
#
gap> p := 31;; N := NumberSmallGroups(p^5);
131
gap> ForAll([1..N], i -> IdSmallGroup(PcgsCopy(SmallGroup(p^5, i))) = [p^5, i]);
true
gap> ForAll([1, 20, 40, 60, 80, 100, 120, N], function(i)
>      local G;
>      G := PcgsCopy(SmallGroup(p^5, i));
>      return IsIsoOntoLibraryGroup(G, IsomorphismSmallGroup(G), [p^5, i]);
>    end);
true

#
# Trivial and cyclic groups, groups not covered by the package
#
gap> IdSmallGroup(TrivialGroup(IsPermGroup));
[ 1, 1 ]
gap> G := TrivialGroup(IsPcGroup);;
gap> IsIsoOntoLibraryGroup(G, IsomorphismSmallGroup(G), [1, 1]);
true
gap> G := CyclicGroup(IsPermGroup, 7^5);;
gap> IdSmallGroup(G);
[ 16807, 1 ]
gap> iso := IsomorphismSmallGroup(G);;
gap> IdSmallGroup(Range(iso)) = [7^5, 1] and Order(Image(iso, G.1)) = 7^5;
true
gap> G := DirectProduct(CyclicGroup(IsPermGroup, 7^2), CyclicGroup(IsPermGroup, 7^3));;
gap> id := [7^5, First([1..NumberSmallGroups(7^5)], i -> IsAbelian(SmallGroup(7^5, i))
>                       and AbelianInvariants(SmallGroup(7^5, i)) = [49, 343])];;
gap> IdSmallGroup(G) = id;
true
gap> IsIsoOntoLibraryGroup(G, IsomorphismSmallGroup(G), id);
true
gap> IdSmallGroup(SymmetricGroup(4));
[ 24, 12 ]
gap> IdSmallGroup(DihedralGroup(64));
[ 64, 52 ]

#
# Stored attributes
#
gap> G := GensCopy(SmallGroup(11^4, 8));;
gap> HasIsomorphismSmallGroup(G);
false
gap> IdSmallGroup(G);
[ 14641, 8 ]
gap> HasIsomorphismSmallGroup(G);
true
gap> IsIsoOntoLibraryGroup(G, IsomorphismSmallGroup(G), [11^4, 8]);
true
gap> G := GensCopy(SmallGroup(11^5, 8));;
gap> IdSmallGroup(G);; HasIdGroup(G);
true
gap> iso := IsomorphismSmallGroup(G);; HasIsomorphismSmallGroup(G);
true
gap> IsIdenticalObj(iso, IsomorphismSmallGroup(G));
true
gap> IdGroupsAvailable(7^5);
false

#
# Types of the groups of order p^5
#
gap> ForAll([7, 11, 13, 17, 19, 23, 29, 31, 37], p ->
>      ForAll([1..NumberSmallGroups(p^5)],
>             i -> IdSmallGroupFromType_p5(p, TypeFromIdSmallGroup_p5(p, i)) = i));
true
gap> ForAll([7, 11, 13, 17], p -> ForAll([1..70], t ->
>      Flat([IdSmallGroupFromType_p5(p, t)]) =
>        Filtered([1..NumberSmallGroups(p^5)],
>                 i -> TypeFromIdSmallGroup_p5(p, i)[1] = t)
>      and IdSmallGroupFromType_p5(p, t) = IdSmallGroupFromType_p5(p, [t])));
true
gap> List([11, 12, 29, 32, 33, 48, 50], t -> Length(IdSmallGroupFromType_p5(13, t)));
[ 6, 6, 3, 3, 4, 6, 6 ]
gap> IdSmallGroupFromType_p5(11, 29);
37
gap> IdSmallGroupFromType_p5(11, [29, 1]);
37
gap> TypeFromIdSmallGroup_p5(11, 37);
[ 29, 1 ]
gap> IdSmallGroupFromType_p5(5, 1);
Error, wrong input
gap> IdSmallGroupFromType_p5(7, 71);
Error, wrong input
gap> IdSmallGroupFromType_p5(7, [11, 0]);
Error, wrong input
gap> IdSmallGroupFromType_p5(7, [11, 4]);
Error, Type does not exist
gap> TypeFromIdSmallGroup_p5(7, 84);
Error, wrong input
gap> TypeFromIdSmallGroup_p5(9, 1);
Error, wrong input

#
# The global names of the package, apart from the internal names starting
# with p5id_
#
gap> Set(Filtered(NamesGVars(), x -> IsBoundGlobal(x) and not StartsWith(x, "p5id_")
>      and (EndsWith(x, "_p5") or x in ["InfoIdp5", "IsomorphismSmallGroup"])))
>    = [ "IdSmallGroupFromType_p5", "InfoIdp5", "IsomorphismSmallGroup",
>        "TestSmallGroupID_p5", "TypeFromIdSmallGroup_p5" ];
true

#
gap> STOP_TEST("idp5.tst");
